{
  "name": "gov-report-diff",
  "version": "1.0.0",
  "description": "政府信息公开年度报告差异比对系统",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:llm": "cross-env DATABASE_TYPE=postgres PORT=8787 FRONTEND_URL=http://localhost:3001 ts-node src/index-llm.ts",
    "health:llm": "node scripts/llm-health.js",
    "ports:llm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/llm-ports.ps1 -Port 8787",
    "smoke:llm": "node scripts/llm-smoke-insert.js",
    "start:llm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/llm-start.ps1 -Port 8787",
    "stop:llm": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/llm-stop.ps1 -Port 8787",
    "restart:llm": "npm run stop:llm && npm run build && npm run start:llm",
    "generate:gov-report": "node -r ts-node/register/transpile-only scripts/generate-gov-insight-report.ts",
    "govinsight:phase1:bootstrap": "node -r ts-node/register/transpile-only scripts/govinsight-phase1-bootstrap.ts",
    "govinsight:phase1:verify": "node -r ts-node/register/transpile-only scripts/govinsight-phase1-verify.ts",
    "govinsight:phase1:reconcile": "node -r ts-node/register/transpile-only scripts/govinsight-phase1-reconcile.ts",
    "govinsight:phase1:regression": "node -r ts-node/register/transpile-only scripts/govinsight-phase1-regression.ts",
    "govinsight:phase2:leader-cockpit:verify": "node -r ts-node/register/transpile-only scripts/govinsight-phase2-leader-cockpit-verify.ts",
    "govinsight:phase2:multicity-reconcile": "node -r ts-node/register/transpile-only scripts/govinsight-phase2-multicity-reconcile.ts",
    "govinsight:phase2:report-protocol:verify": "node -r ts-node/register/transpile-only scripts/govinsight-phase2-report-protocol-verify.ts",
    "govinsight:phase2:report-result-reconcile": "node -r ts-node/register/transpile-only scripts/govinsight-phase2-report-result-reconcile.ts",
    "govinsight:phase3:backfill-missing-city-reports": "node -r ts-node/register/transpile-only scripts/govinsight-phase3-backfill-missing-city-reports.ts",
    "govinsight:phase3:regenerate-city-ai-reports": "node -r ts-node/register/transpile-only scripts/govinsight-phase3-regenerate-city-ai-reports.ts",
    "govinsight:phase3:repair-ai-reports": "node -r ts-node/register/transpile-only scripts/govinsight-phase3-repair-ai-reports.ts",
    "test:relay": "ts-node scripts/test-model-connectivity.ts",
    "build": "tsc && node scripts/copy-public.js",
    "start": "node -r dotenv/config dist/index-llm.js",
    "start:prod": "node -r dotenv/config dist/index-llm.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:pbt": "jest --testPathPattern=pbt",
    "test:phase2": "jest --testPathPattern=phase2",
    "test:regression": "jest --testPathPattern=regressionSmoke",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node src/scripts/db-migrate.ts",
    "scan:integrity": "ts-node src/scripts/scan-system-integrity.ts",
    "scan:table3-fragments": "ts-node src/scripts/scan-table3-fragmentation.ts",
    "repair:missing-active-sources": "ts-node src/scripts/repair-missing-active-sources.ts",
    "recover:missing-active-sources": "ts-node src/scripts/recover-missing-active-sources-from-root.ts",
    "prioritize:unstable-parses": "ts-node src/scripts/prioritize-unstable-parses.ts",
    "reparse:priority-unstable": "ts-node src/scripts/reparse-priority-unstable-batch.ts",
    "trace:parse-materialize": "ts-node src/scripts/trace-parse-materialize.ts",
    "repair:active-facts": "ts-node src/scripts/repair-active-facts.ts",
    "fix:fail-missing-jobs": "ts-node src/scripts/fail-missing-parse-jobs.ts --apply",
    "fix:merge-duplicates": "ts-node src/scripts/merge-duplicate-reports.ts --apply",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src"
  },
  "keywords": [
    "government",
    "report",
    "diff",
    "comparison"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/archiver": "^7.0.0",
    "@types/ejs": "^3.1.5",
    "archiver": "^7.0.1",
    "axios": "^1.6.2",
    "bullmq": "^5.76.3",
    "cheerio": "^1.1.2",
    "csv-parse": "^6.2.1",
    "diff": "^8.0.2",
    "diff-match-patch": "^1.0.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.17.0",
    "pdfjs-dist": "^5.6.205",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "puppeteer": "^24.34.0",
    "read-excel-file": "^9.0.6",
    "redis": "^4.6.12",
    "write-excel-file": "^4.0.2"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.6",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.11.2",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "fast-check": "^3.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "minimatch": "^9.0.9",
    "tar": "^7.5.13"
  }
}
