# ============================================
# KIROGOVCOMPARE 系统配置文件
# ============================================

# --- 核心配置 ---
PORT=8787
NODE_ENV=production
LOG_LEVEL=info

# --- LLM 模型配置 ---
# 主模型固定走 GPT-5.5 专用 OpenAI 兼容中转站
# AI runtime is unified to openai/gpt-5.5 only.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5

# --- 智能辅策报告生成模型（独立于年报解析）---
GOV_INSIGHT_REPORT_PROVIDER=openai
GOV_INSIGHT_REPORT_MODEL=gpt-5.5
GOV_INSIGHT_REPORT_TEMPERATURE=0.3
GOV_INSIGHT_REPORT_THINKING_BUDGET=0
GOV_INSIGHT_REPORT_RESPONSE_MIME_TYPE=application/json
GOV_INSIGHT_REPORT_MAX_OUTPUT_TOKENS=4096
GOV_INSIGHT_REPORT_TIMEOUT_MS=600000

GOV_INSIGHT_REPORT_OPENAI_API_MODE=responses
GOV_INSIGHT_REPORT_OPENAI_REASONING_EFFORT=xhigh

# --- 年报解析模型（独立于报告生成）---
LLM_PARSE_PROVIDER=openai
LLM_PARSE_MODEL=gpt-5.5
LLM_PARSE_MODEL_OPTIONS_JSON=[{"value":"openai/gpt-5.5","label":"GPT-5.5"}]
LLM_PARSE_CONSENSUS_ENABLED=false
LLM_PARSE_RULE_GATE_ENABLED=true

# --- GPT-5.5 专用 OpenAI 兼容中转站 ---
OPENAI_API_KEY=sk-893b21e9c422335d10ba1c6a2c5fa307cf878675d682a5633f4480866d86de02
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=http://api.2729453.xyz
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=xhigh
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_RESPONSE_STRICT=false
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_INPUT_MAX_CHARS=120000
OPENAI_MAX_OUTPUT_TOKENS=4096

# --- AI 差异建议服务 ---
AI_SUGGESTION_PROVIDER=openai
AI_SUGGESTION_MODEL=gpt-5.5

AI_SUGGESTION_OPENAI_API_MODE=responses
AI_SUGGESTION_TEMPERATURE=0.7
AI_SUGGESTION_MAX_TOKENS=1000

# --- 安全配置 ---
JWT_SECRET=55b7ebbc951b7b6a5edb90cde458dda51691251c5bf83c023474fd0402e63485
ADMIN_BOOTSTRAP_TOKEN=63783b0009706f2701c02ed5b2a0bddc

# --- CORS 跨域配置 ---
