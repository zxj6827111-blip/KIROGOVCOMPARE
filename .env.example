# ========================================
# KIROGOVCOMPARE Environment Example
# ========================================

# Database (PostgreSQL)
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gov_report_diff
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gov-report-diff

# Server
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
TRUST_PROXY=false

# Security (must set in production)
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# ========================================
# AI Model
# ========================================
# Supported providers: openai, gemini, gemini_openai, modelscope, zhipu, nvidia, stub

# Primary model: dedicate this relay to GPT-5.4 only
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4

# Fallback model (2nd retry): separate Gemini OpenAI-compatible endpoint
LLM_FALLBACK_PROVIDER=gemini_openai
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite-preview

# GovInsight formal-report generation model (independent from annual-report parsing)
# Current report-job retries stay on the same model and do not switch to a separate fallback provider.
GOV_INSIGHT_REPORT_PROVIDER=openai
GOV_INSIGHT_REPORT_MODEL=gpt-5.4
GOV_INSIGHT_REPORT_TEMPERATURE=0.3
GOV_INSIGHT_REPORT_THINKING_BUDGET=0
GOV_INSIGHT_REPORT_RESPONSE_MIME_TYPE=application/json
GOV_INSIGHT_REPORT_MAX_OUTPUT_TOKENS=4096
GOV_INSIGHT_REPORT_TIMEOUT_MS=600000

# Parse model: annual report parsing is independent from report generation
LLM_PARSE_PROVIDER=zhipu
LLM_PARSE_MODEL=glm-5
LLM_PARSE_MODEL_OPTIONS_JSON=[{"value":"zhipu/glm-5","label":"GLM-5 (Zhipu)"},{"value":"gemini/gemini-3.1-flash-lite-preview","label":"Gemini 3.1 Flash Lite"},{"value":"gemini/gemini-3-flash-preview","label":"Gemini 3 Flash"}]

# Parse fallback model (2nd retry for parsing jobs)
LLM_PARSE_FALLBACK_PROVIDER=zhipu
LLM_PARSE_FALLBACK_MODEL=glm-5

# Dual-AI consensus gate
LLM_PARSE_CONSENSUS_ENABLED=false
LLM_PARSE_CONSENSUS_PROVIDER=
LLM_PARSE_CONSENSUS_MODEL=
LLM_PARSE_CONSENSUS_ALLOW_SAME_MODEL=true

# Rule gate (hard block when false checks fail)
LLM_PARSE_RULE_GATE_ENABLED=true

# GPT-5.4 dedicated OpenAI-compatible relay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_BASE_URL=https://gmn.chuangzuoli.com/v1
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=low
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_RESPONSE_STRICT=false
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_INPUT_MAX_CHARS=120000
OPENAI_MAX_OUTPUT_TOKENS=4096

# GovInsight formal report jobs default to a lighter OpenAI request mode
GOV_INSIGHT_REPORT_OPENAI_API_MODE=chat_completions
GOV_INSIGHT_REPORT_OPENAI_REASONING_EFFORT=low

# Gemini backup via Google OpenAI-compatible endpoint
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_OPENAI_API_MODE=chat_completions

# Zhipu official parse model
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL_ALIASES_JSON={"glm-5-official":"glm-5","glm5-official":"glm-5","glm-4.7-flash-official":"glm-4.7-flash","glm-4.5-air-official":"glm-4.5-air","glm-4-plus-official":"glm-4-plus","glm-4-flash-official":"glm-4-flash"}

# ModelScope / Nvidia optional providers
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=qwen-plus
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/chat/completions
MODELSCOPE_MODEL_ALIASES_JSON={"glm-4.7-flash":"ZhipuAI/GLM-4.7-Flash","deepseek-v3":"deepseek-ai/DeepSeek-V3.2","kimi-k2.5":"moonshotai/Kimi-k2.5"}
NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v3.2
KIMI_MODEL=moonshotai/kimi-k2.5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI suggestion service
AI_SUGGESTION_API_KEY=
AI_SUGGESTION_BASE_URL=https://gmn.chuangzuoli.com/v1
AI_SUGGESTION_MODEL=gpt-5.4
AI_SUGGESTION_TEMPERATURE=0.7
AI_SUGGESTION_MAX_TOKENS=1000

# Logging
LOG_LEVEL=info

# CORS (set real domains in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Upload limits
REPORT_UPLOAD_MAX_BYTES=52428800
REGION_IMPORT_MAX_BYTES=5242880
REGION_IMPORT_MAX_ROWS=10000

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=rate_limit:

# PDF export service token
PDF_EXPORT_SERVICE_USER_ID=1
PDF_EXPORT_SERVICE_USERNAME=pdf-export-worker
