# ========================================
# KIROGOVCOMPARE Environment Example
# ========================================

# Database (PostgreSQL)
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gov_report_diff
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gov-report-diff

# Server
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# Security (must set in production)
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# ========================================
# AI Model
# ========================================
# Supported providers: gemini, modelscope, stub

# Primary model
LLM_PROVIDER=modelscope
LLM_MODEL=qwen3-235b

# Fallback model (2nd retry)
LLM_FALLBACK_PROVIDER=modelscope
LLM_FALLBACK_MODEL=moonshotai/Kimi-k2.5

# Dual-AI consensus gate (recommended in production)
LLM_PARSE_CONSENSUS_ENABLED=true
LLM_PARSE_CONSENSUS_PROVIDER=gemini
LLM_PARSE_CONSENSUS_MODEL=gemini-2.5-flash
# false means validator model must differ from primary model
LLM_PARSE_CONSENSUS_ALLOW_SAME_MODEL=false

# Rule gate (hard block when false checks fail)
LLM_PARSE_RULE_GATE_ENABLED=true

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# options: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro, gemini-3.0-flash

# ModelScope
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=qwen3-235b
# options: qwen3-235b, qwen-plus, deepseek-v3, mimo-v2

# Logging
LOG_LEVEL=info

# CORS (set real domains in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=rate_limit:

# PDF export service token
PDF_EXPORT_SERVICE_USER_ID=1
PDF_EXPORT_SERVICE_USERNAME=pdf-export-worker
