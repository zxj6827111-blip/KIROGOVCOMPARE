# ========================================
# KIROGOVCOMPARE Environment Example
# ========================================

# Database (PostgreSQL)
DATABASE_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gov_report_diff
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gov-report-diff

# Server
PORT=8787
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
TRUST_PROXY=false

# Security (must set in production)
JWT_SECRET=
ADMIN_BOOTSTRAP_TOKEN=

# ========================================
# AI Model
# ========================================
# Runtime model policy: GPT-5.5 only. Fallback models are intentionally disabled.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.5

# Annual-report parsing uses the same unified provider/model.
LLM_PARSE_PROVIDER=openai
LLM_PARSE_MODEL=gpt-5.5
LLM_PARSE_MODEL_OPTIONS_JSON=[{"value":"openai/gpt-5.5","label":"GPT-5.5"}]

# GovInsight formal report generation uses the same unified provider/model.
GOV_INSIGHT_REPORT_PROVIDER=openai
GOV_INSIGHT_REPORT_MODEL=gpt-5.5
GOV_INSIGHT_REPORT_TEMPERATURE=0.3
GOV_INSIGHT_REPORT_THINKING_BUDGET=0
GOV_INSIGHT_REPORT_RESPONSE_MIME_TYPE=application/json
GOV_INSIGHT_REPORT_MAX_OUTPUT_TOKENS=4096
GOV_INSIGHT_REPORT_TIMEOUT_MS=600000
GOV_INSIGHT_REPORT_OPENAI_API_MODE=responses
GOV_INSIGHT_REPORT_OPENAI_REASONING_EFFORT=xhigh

# Dual-AI consensus gate is off because this deployment keeps one model only.
LLM_PARSE_CONSENSUS_ENABLED=false
LLM_PARSE_CONSENSUS_PROVIDER=
LLM_PARSE_CONSENSUS_MODEL=
LLM_PARSE_CONSENSUS_ALLOW_SAME_MODEL=true

# Rule gate (hard block when false checks fail)
LLM_PARSE_RULE_GATE_ENABLED=true

# GPT-5.5 dedicated OpenAI-compatible relay
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=http://api.2729453.xyz
OPENAI_API_MODE=responses
OPENAI_REASONING_EFFORT=xhigh
OPENAI_RESPONSE_FORMAT=json_schema
OPENAI_RESPONSE_STRICT=false
OPENAI_DISABLE_RESPONSE_STORAGE=true
OPENAI_INPUT_MAX_CHARS=120000
OPENAI_MAX_OUTPUT_TOKENS=4096

# AI suggestion service uses the same unified provider/model.
AI_SUGGESTION_PROVIDER=openai
AI_SUGGESTION_MODEL=gpt-5.5
AI_SUGGESTION_OPENAI_API_MODE=responses
AI_SUGGESTION_TEMPERATURE=0.7
AI_SUGGESTION_MAX_TOKENS=1000

# OCR visual review for table 2/3/4. Uses the same OpenAI relay by default.
VISION_REVIEW_ENABLED=true
VISION_REVIEW_PROVIDER=openai
VISION_REVIEW_MODEL=gpt-5.5
VISION_REVIEW_API_MODE=auto
VISION_REVIEW_TIMEOUT_MS=120000

# Logging
LOG_LEVEL=info

# CORS (set real domains in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Upload limits
REPORT_UPLOAD_MAX_BYTES=52428800
REGION_IMPORT_MAX_BYTES=5242880
REGION_IMPORT_MAX_ROWS=10000

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_PREFIX=rate_limit:

# PDF export service token
PDF_EXPORT_SERVICE_USER_ID=1
PDF_EXPORT_SERVICE_USERNAME=pdf-export-worker
